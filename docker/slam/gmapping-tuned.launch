<!--
  Kísérleti, visszaállítható bemutatóprofil. A gmapping.launch változatlan baseline marad.
  A 2026-09-21-i élő mérésben a hibás gyors fordulások pontszáma 864-919-re esett,
  míg álló helyzetben 1430-1460 volt. A mostani baseline 8 részecskével is elérte egy
  teljes CPU-mag terhelését, ezért a korábbi 20-részecskés ötletet nem használjuk.
-->
<launch>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom_combined"/>
    <!-- Ritkább térképkiadás kisebb CPU- és rosbridge-terhelést okoz. -->
    <param name="map_update_interval" value="0.5"/>
    <param name="maxUrange" value="11"/>
    <param name="maxRange" value="12"/>

    <!-- A gyári Wheeltec scanillesztő-paraméterek. A lskip=1 minden második sugarat használ. -->
    <param name="sigma" value="0.05"/>
    <param name="kernelSize" value="1"/>
    <param name="lstep" value="0.05"/>
    <param name="astep" value="0.05"/>
    <param name="iterations" value="5"/>
    <param name="lsigma" value="0.075"/>
    <param name="ogain" value="3.0"/>
    <param name="lskip" value="1"/>

    <param name="linearUpdate" value="0.05"/>
    <param name="angularUpdate" value="0.05"/>
    <param name="temporalUpdate" value="0.5"/>

    <!-- A CPU-mérés miatt marad a gyári 8 részecske. -->
    <param name="particles" value="8"/>
    <param name="resampleThreshold" value="0.5"/>

    <!-- A mecanum kerékodometria forduláskor csúszhat: köztes zajértékek a gyári és a régi kísérlet között. -->
    <param name="srr" value="0.05"/>
    <param name="srt" value="0.10"/>
    <param name="str" value="0.05"/>
    <param name="stt" value="0.20"/>

    <!-- A mért 864-919-es hibás illesztéseket elutasítja; az 1430 feletti stabilakat elfogadja. -->
    <param name="minimumScore" value="1000"/>

    <param name="llsamplerange" value="0.01"/>
    <param name="llsamplestep" value="0.01"/>
    <param name="lasamplerange" value="0.005"/>
    <param name="lasamplestep" value="0.005"/>
    <param name="xmin" value="-10.0"/>
    <param name="ymin" value="-10.0"/>
    <param name="xmax" value="10.0"/>
    <param name="ymax" value="10.0"/>
    <param name="delta" value="0.05"/>
    <remap from="scan" to="/scan"/>
  </node>
</launch>
