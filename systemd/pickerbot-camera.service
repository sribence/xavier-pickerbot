[Unit]
Description=Pickerbot rear Astra RGB-D camera
After=pickerbot-bringup.service
Requires=pickerbot-bringup.service
PartOf=pickerbot-bringup.service

[Service]
Type=simple
User=wheeltec
Environment=HOME=/home/wheeltec
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
TimeoutStartSec=90
ExecStartPre=/bin/bash -c "source /opt/ros/noetic/setup.bash; for n in {1..60}; do rosparam get /run_id >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1"
ExecStart=/bin/bash -c "source /opt/ros/noetic/setup.bash; source /home/wheeltec/wheeltec_robot/devel/setup.bash; exec roslaunch turn_on_wheeltec_robot wheeltec_camera.launch"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
